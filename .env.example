# Exact browser origin, no path or trailing slash.
PUBLIC_ORIGIN=https://photos.example.com
# Docker network containing your Immich server (docker network ls).
IMMICH_NETWORK=immich_default
# Internal URL, never a user-supplied URL. No /api suffix.
IMMICH_URL=http://immich-server:2283

# Optional: existing web/gateway URL for automatic HTML button injection.
WEB_UPSTREAM_URL=
# Host loopback port; container listens on 8099.
RAW_JPEG_PORT=8100
